<?xml version="1.0"?>
<project name="Docker Symfony App" default="init" basedir=".">
    <property name="symfony.console" value="bin/console" />
    <property name="symfony.env" value="dev" />
    <property name="project.storage.dir" value="${project.basedir}/storage" />
    <property file=".env" prefix="docker-compose" />
    <property file=".env.local" prefix="docker-compose" override="true" />

    <target name="init" depends="database-deploy,storage-prepare">
        <echo message="${phing.project.name} Init - OK" />
    </target>

    <target name="app-deploy">
        <exec executable="php" passthru="true" checkreturn="true">
            <arg line="${symfony.console} cache:clear --env=${symfony.env} --no-warmup" />
        </exec>
        <exec executable="php" passthru="true" checkreturn="true">
            <arg line="${symfony.console} cache:warmup --env=${symfony.env}" />
        </exec>
        <exec executable="php" passthru="true" checkreturn="true">
            <arg line="${symfony.console} assets:install --env=${symfony.env} public" />
        </exec>

        <echo message="${phing.project.name} AppDeploy - OK" />
    </target>

    <target name="database-deploy" depends="database-ready">
        <pdosqlexec url="mysql:host=${docker-compose.ENV_database_host}" userid="root" password="${docker-compose.ENV_database_root_password}" autocommit="true">
            <transaction>
                CREATE DATABASE IF NOT EXISTS ${docker-compose.ENV_database_name} CHARACTER SET utf8 COLLATE utf8_general_ci;
                CREATE USER IF NOT EXISTS ${docker-compose.ENV_database_user}@"%" IDENTIFIED BY "${docker-compose.ENV_database_password}";
                GRANT ALL PRIVILEGES ON ${docker-compose.ENV_database_name}.* TO ${docker-compose.ENV_database_user}@"%" WITH GRANT OPTION;
            </transaction>
        </pdosqlexec>

        <exec executable="php" passthru="true" checkreturn="true">
            <arg line="${symfony.console} doctrine:cache:clear-metadata --env=${symfony.env}" />
        </exec>
        <exec executable="php" passthru="true" checkreturn="true">
            <arg line="${symfony.console} doctrine:schema:update --env=${symfony.env} --force --dump-sql --no-interaction" />
        </exec>
        <exec executable="php" passthru="true" checkreturn="true">
            <arg line="${symfony.console} doctrine:migrations:status --env=${symfony.env}" />
        </exec>
        <exec executable="php" passthru="true" checkreturn="true">
            <arg line="${symfony.console} doctrine:migrations:migrate --env=${symfony.env} --allow-no-migration --no-interaction" />
        </exec>

        <echo message="${phing.project.name} DatabaseDeploy - OK" />
    </target>

    <target name="storage-prepare">
        <mkdir dir="${project.storage.dir}/upload" />
        <chown file="${project.storage.dir}/upload" user="www-data" group="www-data" failonerror="false" />
    </target>

    <target name="database-ready">
        <property name="env.ENV_database_host" value="${docker-compose.ENV_database_host}" override="false" />
        <property name="env.ENV_database_port" value="${docker-compose.ENV_database_port}" override="false" />

        <echo message="Waiting for a database on '${env.ENV_database_host}:${env.ENV_database_port}'..." />
        <retry retryCount="120" retryDelay="1">
            <exec executable="nc" passthru="true" checkreturn="true">
                <arg line="-z -v -w30 ${env.ENV_database_host} ${env.ENV_database_port}" />
            </exec>
        </retry>
        <echo message="Database is ready!" />
    </target>
</project>
