x-php-env: &php-env
    APP_ENV: dev
    APP_DEBUG: 1
    DOCTRINE_PROXY_AUTO_GENERATE: 1
    XDEBUG_CONFIG: "client_host=host.docker.internal"
    PHP_IDE_CONFIG: "serverName=docker.local"

x-php-dev: &php-dev
    build:
        target: dev
    user: "1001:1001"
    environment:
        <<: *php-env
    extra_hosts:
        - "host.docker.internal:host-gateway"
    volumes: !override
        - .:/srv

services:
    nginx:
        volumes: !override
            - ./public:/srv/public

    php:
        <<: *php-dev

    spare:
        <<: *php-dev

    init:
        user: "1001:1001"
        profiles: ["init"]

#    mysql:
#        image: mysql:8.0-oracle
