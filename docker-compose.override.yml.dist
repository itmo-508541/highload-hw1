services:
    nginx:
        volumes: !override
            - ./public:/srv/public

    php:
        build:
            target: dev
        user: "1001:1001"
        environment:
            APP_ENV: dev
            APP_DEBUG: 1
            DOCTRINE_PROXY_AUTO_GENERATE: 1
            XDEBUG_CONFIG: "client_host=host.docker.internal"
            PHP_IDE_CONFIG: "serverName=docker.local"
        extra_hosts:
            - "host.docker.internal:host-gateway"
        volumes: !override
            - .:/srv

    init:
        user: "1001:1001"
        profiles: ["init"]

    phpmyadmin:
        image: phpmyadmin:latest
        ports:
            - 8080:80
        networks:
            - mysql
        depends_on:
            - mysql
        environment:
            PMA_ARBITRARY: "1"
            PMA_HOST: "mysql"
            PMA_USER: "root"
            PMA_PASSWORD: "root"

#    mysql:
#        image: mysql:8.0-oracle
