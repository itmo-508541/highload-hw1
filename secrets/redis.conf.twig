# Redis defaults for a single shared instance (sessions, cache, queues).
# Eviction applies only to keys with TTL — set TTL on cache entries.
# Raise maxmemory or add a second Redis when workloads grow.
# Full reference: https://raw.githubusercontent.com/redis/redis/8.6/redis.conf
#
maxmemory 128mb
maxmemory-policy volatile-lru

requirepass {{ env.ENV_redis_password }}
