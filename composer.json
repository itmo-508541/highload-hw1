{
    "type": "project",
    "license": "proprietary",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-redis": "*",
        "ext-zlib": "*",
        "beberlei/doctrineextensions": "^1.3",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4",
        "doctrine/orm": "^3.6",
        "friendsofsymfony/rest-bundle": "^3.3",
        "gedmo/doctrine-extensions": "^3.7",
        "lexik/jwt-authentication-bundle": "^3.2",
        "nelmio/api-doc-bundle": "^5",
        "nyholm/psr7": "^1.8",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.15",
        "sonata-project/doctrine-orm-admin-bundle": "^4.0",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "7.4.*",
        "symfony/runtime": "^7.4",
        "symfony/serializer": "7.4.*",
        "symfony/uid": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "behat/behat": "^3.30",
        "behat/mink-browserkit-driver": "^2.3",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/symfony-extension": "^2.6",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpdoc-parser": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13",
        "rector/rector": "^2.3",
        "robertfausk/behat-panther-extension": "^2.0",
        "symfony/maker-bundle": "^1.33",
        "symfony/panther": "^2.4",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/stopwatch": "^7.4",
        "symfony/web-profiler-bundle": "^7.4"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.21"
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Behat\\": "features/bootstrap/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        },
        "runtime": {
            "dotenv_overload": true
        }
    }
}
