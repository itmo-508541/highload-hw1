default:
    suites:
        # Suite один. Срез браузерных сценариев делается тегом `@javascript`:
        # сессию по нему переключает сам MinkExtension, разной конфигурации
        # у срезов нет. Понадобится — инструмент для этого профиль, не suite.
        default:
            paths:
                - '%paths.base%/features'
            # Ключ обязателен даже пустым: без него Behat подставит дефолтный
            # FeatureContext и упадёт на class_exists.
            contexts:
                - App\Behat\HttpApiContext
                - App\Behat\AdminAccessContext
                - App\Behat\ItemStorageContext
                - App\Behat\ServiceHealthContext

    extensions:
        FriendsOfBehat\SymfonyExtension:
            kernel:
                class: App\Kernel
                environment: test
                debug: true
            bootstrap: tests/bootstrap.php

        Robertfausk\Behat\PantherExtension: ~

        Behat\MinkExtension:
            base_url: http://127.0.0.1:9080
            default_session: symfony
            javascript_session: panther
            sessions:
                # Сценарии без `@javascript`: запрос исполняет ядро в процессе
                # Behat (окружение test), без браузера и веб-сервера.
                symfony:
                    symfony: ~
                # Сценарии с `@javascript`: Panther поднимает свой веб-сервер
                # и браузер, приложение под ним работает в окружении e2e.
                panther:
                    panther:
                        options:
                            browser: 'chrome'
                            webServerDir: '%paths.base%/public'
                            env:
                                APP_ENV: e2e
