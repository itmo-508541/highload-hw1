ARG app_image=scratch
FROM ${app_image} AS app


FROM nginx:trixie AS base
COPY docker/nginx/nginx.conf /etc/nginx/
COPY docker/nginx/conf.d/default.conf /etc/nginx/conf.d/
USER nginx


FROM base AS dev
COPY docker/nginx-dev/conf.d/upstream.conf /etc/nginx/conf.d/

FROM base AS prod
COPY docker/nginx/conf.d/upstream.conf /etc/nginx/conf.d/
COPY --from=app /srv/public/ /srv/public/
